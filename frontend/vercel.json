{
  "crons": [
    { "path": "/api/cron/rebuild", "schedule": "5 10 * * *" }
  ],
  "functions": {
    "api/sitemap.js": {
      "includeFiles": "public/sitemap-static.xml"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/shell.html"
    }
  ],
  "redirects": [
    {
      "source": "/vehicles/buses",
      "destination": "/fleet",
      "permanent": true
    },
    {
      "source": "/blog/maryland-party-bus-rental-guide",
      "destination": "/vehicles/sprinters",
      "permanent": true
    },
    {
      "source": "/blog/md-party-bus-vs-limo-which-is-right-for-your-group",
      "destination": "/vehicles/sprinters",
      "permanent": true
    },
    {
      "source": "/blog/charter-bus-vs-party-bus-vs-limo-which-fits-your-group",
      "destination": "/vehicles/sprinters",
      "permanent": true
    },
    {
      "source": "/booking",
      "destination": "/book-now",
      "permanent": true
    },
    {
      "source": "/capstone-limo-service",
      "destination": "/cape-st-claire-limo-service",
      "permanent": true
    },
    {
      "source": "/snopesville-limo-service",
      "destination": "/sykesville-limo-service",
      "permanent": true
    },
    {
      "source": "/images/:name([^/]+)\\.(jpg|jpeg)",
      "destination": "/images/:name.webp",
      "permanent": true
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    }
  ]
}
